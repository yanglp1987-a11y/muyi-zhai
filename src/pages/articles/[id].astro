
---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection(
    'articles',
    ({ data }) => !data.draft
  );

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const date = article.data.pubDate
  .toISOString()
  .slice(0, 10)
  .replaceAll('-', '.');
---

<Layout
  title={`${article.data.title}｜木易斋`}
  description={article.data.description}
>
  <main class="page">
    <header>
      <a href="/" class="logo">木易斋</a>
      <nav>
        <a href="/">首页</a>
        <a href="/articles/">文章</a>
        <a href="/about/">关于</a>
      </nav>
    </header>

    <article class="content">
      <a href="/articles/" class="back">← 返回文章列表</a>

      <div class="meta">
        <span>{article.data.category}</span>
        <span>{date}</span>
      </div>

      <h1>{article.data.title}</h1>

      <p class="description">{article.data.description}</p>

      <div class="body">
        <Content />
      </div>

      <div class="end">
        <span>—— 木易斋</span>
        <a href="/articles/">返回文章列表 →</a>
      </div>
    </article>

    <footer>木易斋 · 以文字记录生活，以思考认识世界。</footer>
  </main>
</Layout>


<style>
  .page {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 28px;
    color: #302f2b;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 36px 0;
  }

  .logo {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 25px;
    color: #302f2b;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #77736b;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: #8b735c;
  }

  .content {
    max-width: 680px;
    margin: 65px auto 100px;
  }

  .back {
    display: inline-block;
    margin-bottom: 40px;
    color: #8b735c;
    font-size: 13px;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  .meta {
    display: flex;
    gap: 18px;
    color: #999187;
    font-size: 13px;
  }

  h1 {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 1px;
    margin: 22px 0 12px;
  }

  .description {
    color: #999187;
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 48px;
  }

  .body {
    font-family: "Noto Serif SC", "Songti SC", "Microsoft YaHei", serif;
    font-size: 17px;
    line-height: 2.1;
    letter-spacing: 0.4px;
    color: #45423c;
    overflow-wrap: break-word;
  }

  .body p {
    margin: 0 0 26px;
  }

  .body h2 {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0.5px;
    color: #302f2b;
    margin: 48px 0 20px;
  }

  .body h3 {
    font-size: 18px;
    font-weight: 400;
    margin: 35px 0 15px;
  }

  .body blockquote {
    margin: 30px 0;
    padding: 5px 0 5px 20px;
    border-left: 2px solid #c8b7a3;
    color: #888075;
  }

  .body a {
    color: #8b735c;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .end {
    display: flex;
    justify-content: space-between;
    margin-top: 60px;
    padding-top: 25px;
    border-top: 1px solid #e5e0d8;
    color: #8b735c;
    font-size: 13px;
  }

  .end a {
    color: #8b735c;
    text-decoration: none;
  }

  .end a:hover {
    text-decoration: underline;
  }

  footer {
    text-align: center;
    padding: 30px 0;
    border-top: 1px solid #e5e0d8;
    color: #999187;
    font-size: 12px;
  }

  @media (max-width: 600px) {
    .page {
      padding: 0 20px;
    }

    header {
      padding: 25px 0;
    }

    nav {
      gap: 15px;
    }

    .content {
      margin: 40px auto 70px;
    }

    .back {
      margin-bottom: 30px;
    }

    h1 {
      font-size: 26px;
      line-height: 1.5;
    }

    .description {
      margin-bottom: 35px;
    }

    .body {
      font-size: 16px;
      line-height: 2;
      letter-spacing: 0.2px;
    }

    .body p {
      margin-bottom: 22px;
    }

    .body h2 {
      font-size: 20px;
      margin: 38px 0 16px;
    }

    .end {
      margin-top: 45px;
    }
  }
</style>
