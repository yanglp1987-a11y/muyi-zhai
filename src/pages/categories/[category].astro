
---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allArticles = await getCollection('articles');

  const publishedArticles = allArticles
    .filter((article) => !article.data.draft);

  const categories = [
    ...new Set(publishedArticles.map((article) => article.data.category))
  ];

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      articles: publishedArticles
        .filter((article) => article.data.category === category)
        .sort(
          (a, b) =>
            b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
        )
    }
  }));
}

const { category, articles } = Astro.props;
---

<Layout
  title={`${category}｜木易斋`}
  description={`阅读木易斋「${category}」分类下的文章，记录生活、阅读、观察与思考。`}
>
  <main class="page">
    <header>
      <a href="/" class="logo">木易斋</a>
      <nav>
        <a href="/">首页</a>
        <a href="/articles/">文章</a>
        <a href="/about/">关于</a>
      </nav>
    </header>

    <section class="intro">
      <a href="/articles/" class="back">← 返回文章列表</a>
      <h1>{category}</h1>
      <p>记录与「{category}」有关的文字。</p>
    </section>

    <section class="article-list">
      {articles.map((article) => (
        <article>
          <div class="meta">
            <span>{article.data.category}</span>
            <span>
              {article.data.pubDate.toISOString().slice(0, 10).replaceAll('-', '.')}
            </span>
          </div>

          <h2>
            <a href={`/articles/${article.id}/`}>
              {article.data.title}
            </a>
          </h2>

          <p>{article.data.description}</p>
        </article>
      ))}
    </section>

    <footer>木易斋 · 以文字记录生活，以思考认识世界。</footer>
  </main>
</Layout>

<style>
  .page {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 28px;
    color: #302f2b;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 36px 0;
  }

  .logo {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 25px;
    color: #302f2b;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #77736b;
    text-decoration: none;
    font-size: 14px;
  }

  .intro {
    text-align: center;
    padding: 65px 0 45px;
  }

  .intro h1 {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 34px;
    font-weight: 400;
  }

  .intro p {
    color: #77736b;
    font-size: 14px;
  }

  .back {
    color: #8b735c;
    text-decoration: none;
    font-size: 13px;
  }

  .article-list {
    max-width: 650px;
    margin: 30px auto 100px;
  }

  article {
    padding: 28px 0;
    border-bottom: 1px solid #e5e0d8;
  }

  .meta {
    display: flex;
    gap: 18px;
    color: #999187;
    font-size: 12px;
  }

  h2 {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 20px;
    font-weight: 400;
    margin: 14px 0 10px;
  }

  h2 a {
    color: #302f2b;
    text-decoration: none;
  }

  article p {
    color: #77736b;
    font-size: 14px;
    line-height: 1.8;
  }

  footer {
    text-align: center;
    padding: 30px 0;
    border-top: 1px solid #e5e0d8;
    color: #999187;
    font-size: 12px;
  }

  @media (max-width: 600px) {
    .page {
      padding: 0 20px;
    }

    header {
      padding: 25px 0;
    }

    nav {
      gap: 15px;
    }

    .intro {
      padding: 45px 0 30px;
    }
  }
</style>
