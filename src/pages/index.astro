
---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');

const recentArticles = allArticles
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  .slice(0, 3);
---

<Layout
  title="木易斋｜以文字记录生活，以思考认识世界"
  description="木易斋，一个记录生活、阅读、观察与思考的个人文字空间。"
>
  <main class="home">
    <header class="site-header">
      <a href="/" class="logo">木易斋</a>
      <nav>
        <a href="/">首页</a>
        <a href="/articles/">文章</a>
        <a href="/about/">关于</a>
      </nav>
    </header>

    <section class="intro">
      <h1>以文字记录生活，<br />以思考认识世界。</h1>
      <p>生活、阅读、观察与思考。</p>
    </section>

    <section class="hero">
      <img
        src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=1600"
        alt="宁静的自然风景"
      />
    </section>

    <section class="articles">
      <h2>最近写下的文字</h2>

      {recentArticles.map((article) => (
        <article>
          <a href={`/articles/${article.id}/`}>
            {article.data.title}
          </a>
          <span>
            {article.data.category} · {
              article.data.pubDate
                .toISOString()
                .slice(0, 10)
                .replaceAll('-', '.')
            }
          </span>
        </article>
      ))}
    </section>

    <footer>
      <p>木易斋</p>
      <span>以文字记录生活，以思考认识世界。</span>
    </footer>
  </main>
</Layout>

<style>
  .home {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 28px;
    color: #302f2b;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 36px 0;
  }

  .logo {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 25px;
    color: #302f2b;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #77736b;
    text-decoration: none;
    font-size: 14px;
  }

  .intro {
    text-align: center;
    padding: 65px 0 45px;
  }

  .intro h1 {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 34px;
    font-weight: 400;
    line-height: 1.8;
  }

  .intro p {
    color: #77736b;
    font-size: 14px;
  }

  .hero img {
    width: 100%;
    height: 330px;
    object-fit: cover;
    display: block;
  }

  .articles {
    max-width: 650px;
    margin: 75px auto;
  }

  .articles h2 {
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-size: 21px;
    font-weight: 400;
    margin-bottom: 30px;
  }

  .articles article {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid #e5e0d8;
  }

  .articles article a {
    color: #302f2b;
    text-decoration: none;
    font-size: 16px;
  }

  .articles article span {
    color: #999187;
    font-size: 12px;
    white-space: nowrap;
  }

  footer {
    text-align: center;
    border-top: 1px solid #e5e0d8;
    padding: 35px 0;
    color: #8b735c;
  }

  footer p {
    font-family: "Noto Serif SC", "Songti SC", serif;
  }

  footer span {
    font-size: 12px;
    color: #999187;
  }

  @media (max-width: 600px) {
    .home {
      padding: 0 20px;
    }

    .site-header {
      padding: 25px 0;
    }

    nav {
      gap: 15px;
    }

    .intro {
      padding: 45px 0 30px;
    }

    .intro h1 {
      font-size: 25px;
    }

    .hero img {
      height: 220px;
    }

    .articles article {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
